{
  "name": "sigad-tchad",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --names API,INTERFACE \"npm:dev:api\" \"npm:dev:interface\"",
    "dev:api": "wrangler dev --config wrangler.toml",
    "dev:interface": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "wrangler types --env-interface CloudflareBindings && tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "node scripts/preparer-base-locale.mjs migrate",
    "db:seed:local": "node scripts/preparer-base-locale.mjs seed",
    "db:verifier": "node --experimental-sqlite scripts/verifier-schema-local.mjs",
    "preview": "vite preview --config frontend/vite.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --pool=threads --maxWorkers=1",
    "test:security-matrix": "node scripts/generer-matrice-securite-phase9.mjs --check",
    "test:integration": "node tests/integration/run-auth-worker.mjs",
    "test:e2e": "npm run build && node tests/e2e/run-local.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
